<resources>
    <string name="app_name">eMudhra CA 阻断验证</string>
    <string name="app_subtitle">在本机回环地址上逐一验证 8 个已泄露 eMudhra 中间 CA 是否被 Android 系统默认信任路径阻断。</string>
    <string name="footnote">仅测试系统默认 TrustManager；结果不代表浏览器 CRLSet/吊销检查的结论。</string>
